#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_PATH="$ROOT_DIR/target/release/openfang"
ENV_FILE="$ROOT_DIR/.env"

if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

if [[ "${1-}" == "--build-only" ]]; then
  shift
  cargo build --release -p openfang-cli "$@"
  exit 0
fi

cargo build --release -p openfang-cli
exec "$BIN_PATH" "$@"